{
  "name": "nonsense-research-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "transcripts:build-index": "node scripts/build-transcript-index.ts",
    "transcripts:smoke": "node --env-file-if-exists=.env.local scripts/run-transcript-retrieval.ts smoke",
    "transcripts:embed": "node --env-file-if-exists=.env.local scripts/run-transcript-retrieval.ts documents",
    "transcripts:evaluate-queries": "node --env-file-if-exists=.env.local scripts/run-transcript-retrieval.ts queries",
    "transcripts:evaluate": "node --env-file-if-exists=.env.local scripts/run-transcript-retrieval.ts evaluate",
    "transcripts:benchmark": "node scripts/benchmark-transcript-retrieval.ts",
    "threads:migrate": "node --env-file-if-exists=.env.local scripts/migrate-research-threads.ts",
    "threads:prove": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/thread-store-neon.live.test.ts",
    "security:denylist": "node scripts/check-supply-chain.mjs",
    "gate": "pnpm security:denylist && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.16",
    "@assistant-ui/react-ai-sdk": "1.4.7",
    "@mozilla/readability": "0.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "ai": "7.0.77",
    "ipaddr.js": "2.5.0",
    "jsdom": "29.1.1",
    "lucide-react": "1.33.0",
    "minisearch": "7.2.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "8.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
